{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile containing identity, role, and corporate department metadata.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 254 },
        "name": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "enum": ["staff", "admin"] },
        "department": { "type": "string", "maxLength": 100 },
        "avatar": { "type": "string", "maxLength": 10 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "name", "role", "department"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Admin access control registry defining authorized administrator emails and UID mapping.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 254 },
        "role": { "type": "string", "maxLength": 32 },
        "assignedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "OvertimeEntry": {
      "title": "OvertimeEntry",
      "description": "Overtime log entry recording working hours, projects, and justification for 7th cutoff reconciliation.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 254 },
        "userName": { "type": "string", "maxLength": 128 },
        "department": { "type": "string", "maxLength": 100 },
        "date": { "type": "string", "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "startTime": { "type": "string", "maxLength": 5, "pattern": "^[0-9]{2}:[0-9]{2}$" },
        "endTime": { "type": "string", "maxLength": 5, "pattern": "^[0-9]{2}:[0-9]{2}$" },
        "duration": { "type": "number" },
        "project": { "type": "string", "maxLength": 150 },
        "notes": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "userEmail", "userName", "department", "date", "startTime", "endTime", "duration", "project"]
    },
    "MonthlySubmission": {
      "title": "MonthlySubmission",
      "description": "Monthly OT submission summary tracking submission status, total hours, and review workflow.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 128 },
        "department": { "type": "string", "maxLength": 100 },
        "month": { "type": "string", "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}$" },
        "status": { "type": "string", "enum": ["Pending", "Submitted", "Approved", "Rejected"] },
        "submittedAt": { "type": "string", "maxLength": 64 },
        "totalHours": { "type": "number" },
        "totalEntries": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "userName", "department", "month", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents keyed by Firebase Auth UID."
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Admin privileges registry matching admin UID or user email."
    },
    "/overtimeEntries/{entryId}": {
      "schema": "OvertimeEntry",
      "description": "Collection of employee overtime claims submitted or drafted."
    },
    "/monthlySubmissions/{submissionId}": {
      "schema": "MonthlySubmission",
      "description": "Aggregated monthly submission statuses for payroll 7th-cutoff tracking."
    }
  }
}
